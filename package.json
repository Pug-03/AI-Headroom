{
  "name": "aiheadroom",
  "version": "0.1.0",
  "description": "AI Headroom: see your model, context window and rate limits as colored bars at the bottom of Claude Code and OpenAI Codex CLI.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "aiheadroom": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "install.sh",
    "README.md",
    "README.th.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "node --no-warnings=ExperimentalWarning scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepare": "npm run build",
    "images": "node scripts/gen-images.ts"
  },
  "keywords": [
    "ai",
    "claude-code",
    "codex",
    "codex-cli",
    "statusline",
    "status-line",
    "rate-limit",
    "context-window",
    "tokens",
    "cli",
    "terminal"
  ],
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pug-03/AI-Headroom.git"
  },
  "homepage": "https://github.com/Pug-03/AI-Headroom#readme",
  "bugs": {
    "url": "https://github.com/Pug-03/AI-Headroom/issues"
  }
}
